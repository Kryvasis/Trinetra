{
  "SecurityGroups": [
    {
      "GroupId": "sg-0123456789abcdef0",
      "GroupName": "web-sg",
      "Description": "Web security group - overly permissive",
      "IpPermissions": [
        {
          "IpProtocol": "tcp",
          "FromPort": 22,
          "ToPort": 22,
          "IpRanges": [{"CidrIp": "0.0.0.0/0", "Description": "SSH open to world"}]
        },
        {
          "IpProtocol": "tcp",
          "FromPort": 23,
          "ToPort": 23,
          "IpRanges": [{"CidrIp": "0.0.0.0/0", "Description": "Telnet open - insecure"}]
        },
        {
          "IpProtocol": "tcp",
          "FromPort": 80,
          "ToPort": 80,
          "IpRanges": [{"CidrIp": "0.0.0.0/0", "Description": "HTTP open - insecure"}]
        },
        {
          "IpProtocol": "-1",
          "IpRanges": [{"CidrIp": "0.0.0.0/0", "Description": "All traffic"}]
        }
      ],
      "Tags": [{"Key": "Name", "Value": "aws-lab-01"}]
    }
  ],
  "NetworkAcls": [
    {
      "NetworkAclId": "acl-12345678",
      "Entries": [
        {"RuleNumber": 100, "Protocol": "6", "RuleAction": "allow", "CidrBlock": "10.0.0.0/16"},
        {"RuleNumber": 110, "Protocol": "-1", "RuleAction": "deny", "CidrBlock": "0.0.0.0/0"}
      ]
    }
  ]
}
